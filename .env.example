# 건국대학교 메이커스페이스 - Supabase 및 Cron 연동 환경 변수
# Supabase 대시보드 > Project Settings > API 에서 확인 가능합니다.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# (선택 사항) Vercel Cron 또는 외부 스케줄러 보안 시크릿 키
# Vercel Project Settings > Environment Variables 에 등록
CRON_SECRET=your-random-cron-secret-string
